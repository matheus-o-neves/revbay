# Environment Configuration Template
# Copy this file to .env and fill in your actual values

NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/revbay"
POSTGRES_DB=revbay  
POSTGRES_USER=revbay
POSTGRES_PASSWORD=your_secure_password_here

# Service URLs
API_GATEWAY_URL=http://localhost:3000
PAYMENT_ORCHESTRATOR_URL=http://localhost:3001

# Stripe Configuration (Get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Celcoin Configuration  
CELCOIN_API_URL=https://sandbox.celcoin.com.br
CELCOIN_API_KEY=your_celcoin_api_key_here

# Test Configuration
TEST_API_KEY=your_test_api_key_here
TEST_CUSTOMER_ID=test_customer_id_here
TEST_TIMEOUT=30000
TEST_VERBOSE=false